{
  "manifest_version": 3,
  "name": "DeepSeek Local Assistant",
  "version": "3.0.2",
  "description": "Free DeepSeek AI with streaming, thinking, full page/image analysis, and manual chat.",
  "permissions": ["storage", "sidePanel", "contextMenus", "activeTab"],
  "host_permissions": [
    "http://localhost:8000/",
    "<all_urls>"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "DeepSeek Local",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "omnibox": { "keyword": "ds" },
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Ctrl+Shift+Y" }, "description": "Open side panel" },
    "open_popup": { "suggested_key": { "default": "Ctrl+Shift+P" }, "description": "Open floating window" }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["floating.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}